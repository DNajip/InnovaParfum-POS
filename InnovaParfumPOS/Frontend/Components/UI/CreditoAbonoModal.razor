@using InnovaParfumPOS.Backend.Models
@using InnovaParfumPOS.Backend.Services
@inject ICreditoService CreditoService
@inject ICheckoutService CheckoutService
@inject AppState AppState
@inject ToastService ToastService
@inject IJSRuntime JS
@inject UserSession UserSession

<div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.6); z-index: 1060; overflow-x: hidden;">
    <div class="modal-dialog modal-lg" style="margin-top: 2rem;">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 24px; overflow: hidden;">
            <div class="modal-header border-0 bg-light px-4 pt-3 pb-2">
                <div class="d-flex justify-content-between align-items-start w-100">
                    <div class="d-flex align-items-center gap-3">
                        <div class="kpi-icon kpi-purple" style="width: 42px; height: 42px; border-radius: 10px; background: rgba(111, 66, 193, 0.1); color: #6f42c1; display: flex; align-items: center; justify-content: center; font-size: 1.15rem;">
                            <i class="fas fa-credit-card"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <h5 class="fw-bold m-0 text-dark">Crédito #@Credito.IdCredito</h5>
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25">Factura: @(Credito.Venta?.NumeroFactura ?? "N/A")</span>
                            </div>
                            <div class="d-flex align-items-center gap-3 mt-1" style="font-size: 0.85rem;">
                                <div><span class="text-muted">Original:</span> <span class="fw-bold text-dark">@AppState.CurrencySymbol @Credito.MontoOriginal.ToString("N2")</span></div>
                                <div class="text-danger fw-bold"><i class="fas fa-exclamation-circle me-1"></i>Saldo: @AppState.CurrencySymbol @Credito.SaldoPendiente.ToString("N2")</div>
                                <div class="@(DateTime.Now.Date > Credito.FechaVencimiento.Date && Credito.Estado != "PAGADO" ? "text-danger fw-bold" : "text-muted")">
                                    <i class="far fa-calendar-alt me-1"></i>Vence: @Credito.FechaVencimiento.ToString("dd/MM/yyyy")
                                </div>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn-close mt-1" @onclick="OnClose"></button>
                </div>
            </div>

            <div class="modal-body p-4 bg-white">
                @if (Credito.SaldoPendiente > 0)
                {
                    <div class="row g-4">
                        <!-- FORMULARIO DE ABONO (IZQUIERDA) -->
                        <div class="col-md-7">
                            <div class="card border-0 shadow-sm p-3 bg-light h-100" style="border-radius: 12px;">
                                <h6 class="fw-bold text-secondary mb-3" style="font-size: 0.9rem;"><i class="fas fa-hand-holding-usd me-2 text-primary"></i> REGISTRAR ABONO</h6>
                                
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-muted mb-1">Monto a abonar a la deuda (@AppState.CurrencySymbol)</label>
                                    <input type="number" class="form-control fw-bold text-primary" @bind="MontoAbonarDeuda" @bind:after="UpdateSuggestedAmount" min="0.01" step="0.01" max="@Credito.SaldoPendiente" style="border-radius: 8px; border: 1px solid #dee2e6;" />
                                </div>
                                
                                <div class="row g-2 mb-2">
                                    <div class="col-6">
                                        <label class="small text-muted mb-1 fw-semibold" style="font-size: 0.75rem;">Método de Pago</label>
                                        <select class="form-select bg-white p-2" style="border-radius: 8px;" @bind="currentPayment.IdMetodoPago" @bind:after="UpdateSuggestedAmount">
                                            @if(metodosPago != null) {
                                                foreach (var m in metodosPago)
                                                {
                                                    <option value="@m.IdMetodo">@m.Nombre</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-6">
                                        <label class="small text-muted mb-1 fw-semibold" style="font-size: 0.75rem;">Dinero Recibido</label>
                                        <div class="input-group" style="border-radius: 8px;">
                                            <span class="input-group-text bg-white fw-bold text-primary" style="border-top-left-radius: 8px; border-bottom-left-radius: 8px; border-right: none;">
                                                @(metodosPago?.FirstOrDefault(m => m.IdMetodo == currentPayment.IdMetodoPago)?.IdMonedaNavigation?.Simbolo ?? AppState.CurrencySymbol)
                                            </span>
                                            <input type="number" step="0.01" class="form-control bg-white fw-bold text-dark border-left-0" style="border-top-right-radius: 8px; border-bottom-right-radius: 8px;" @bind="currentPayment.Monto" />
                                        </div>
                                    </div>
                                    <div class="col-12 mt-2">
                                        <input type="text" class="form-control bg-white form-control-sm p-2" style="border-radius: 8px;" @bind="currentPayment.Referencia" placeholder="Referencia / Autorización (Opcional)" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- RESUMEN DEL ABONO Y VUELTO (DERECHA) -->
                        <div class="col-md-5 d-flex flex-column">
                            <div class="card border-0 p-3 flex-grow-1 shadow-sm" style="border-radius: 12px; background: linear-gradient(145deg, #ffffff, #f8fafc); border: 1px solid #dee2e6 !important;">
                                
                                <div class="d-flex justify-content-between mb-1 align-items-center">
                                    <span class="text-muted small fw-semibold">Abono:</span>
                                    <span class="fw-bold text-dark">@AppState.CurrencySymbol @MontoAbonarDeuda.ToString("N2")</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2 pb-2 border-bottom align-items-center">
                                    <span class="text-muted small fw-semibold">Recibido:</span>
                                    <span class="fw-bold text-success">@AppState.CurrencySymbol @TotalPagado.ToString("N2")</span>
                                </div>

                                @if (SaldoRestante > 0)
                                {
                                    <div class="d-flex justify-content-between align-items-center mb-2 p-2 rounded mt-auto" style="background: rgba(239, 68, 68, 0.05); border: 1px solid rgba(239, 68, 68, 0.2);">
                                        <span class="text-danger fw-bold small"><i class="fas fa-exclamation-circle me-1"></i>FALTA RECIBIR</span>
                                        <span class="fw-bold mb-0 text-danger">@AppState.CurrencySymbol @SaldoRestante.ToString("N2")</span>
                                    </div>
                                }
                                else if (SaldoRestante <= 0 && currentPayment.Monto > 0)
                                {
                                    <div class="mt-auto p-2 rounded shadow-sm" style="background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.3);">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="text-success fw-bold small" style="font-size: 0.75rem;"><i class="fas fa-check-circle me-1"></i>VUELTO / CAMBIO</span>
                                            <div class="btn-group btn-group-sm bg-white rounded shadow-sm" role="group">
                                                <input type="radio" class="btn-check" name="monedaVuelto" id="vueltoUSD" value="USD" checked="@(MonedaVuelto == "USD")" @onchange='() => MonedaVuelto = "USD"'>
                                                <label class="btn btn-outline-success px-2 py-0 border-0" for="vueltoUSD" style="font-size: 0.7rem;">USD</label>

                                                <input type="radio" class="btn-check" name="monedaVuelto" id="vueltoNIO" value="NIO" checked="@(MonedaVuelto == "NIO")" @onchange='() => MonedaVuelto = "NIO"'>
                                                <label class="btn btn-outline-success px-2 py-0 border-0" for="vueltoNIO" style="font-size: 0.7rem;">C$</label>
                                            </div>
                                        </div>
                                        <div class="d-flex justify-content-end align-items-center mt-1">
                                            <span class="fs-5 fw-bold mb-0 text-success">
                                                @(MonedaVuelto == "USD" ? "$" : "C$") 
                                                @((AppState.CurrencyCode == "USD" 
                                                    ? (MonedaVuelto == "USD" ? Math.Abs(SaldoRestante) : Math.Abs(SaldoRestante) * AppState.ExchangeRateBuy)
                                                    : (MonedaVuelto == "USD" ? Math.Abs(SaldoRestante) / AppState.ExchangeRateSell : Math.Abs(SaldoRestante))
                                                ).ToString("N2"))
                                            </span>
                                        </div>
                                    </div>
                                }

                                <button type="button" class="btn btn-primary w-100 d-inline-flex justify-content-center align-items-center gap-2 fw-bold shadow-sm mt-3" 
                                        disabled="@(isProcessing || SaldoRestante > 0 || MontoAbonarDeuda <= 0)" @onclick="RegistrarAbono" style="border-radius: 8px; padding: 10px; font-size: 0.95rem; background: linear-gradient(135deg, #0ea5e9, #0284c7); border: none;">
                                    @if (isProcessing)
                                    {
                                        <span class="spinner-border spinner-border-sm"></span>
                                        <span>Procesando...</span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-check-circle"></i>
                                        <span>REGISTRAR ABONO</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-success text-center py-3 mb-0 rounded-3 border-0 shadow-sm" style="background: rgba(16, 185, 129, 0.1);">
                        <i class="fas fa-check-circle fs-3 text-success mb-2"></i>
                        <h6 class="fw-bold text-success m-0">Crédito Cancelado Totalmente</h6>
                    </div>
                }

                <!-- HISTORIAL DE ABONOS (ACORDEÓN COMPACTO) -->
                <div class="accordion mt-4 border-0 shadow-sm" id="accordionHistorial" style="border-radius: 16px; overflow: hidden;">
                    <div class="accordion-item border-0">
                        <h2 class="accordion-header" id="headingHistorial">
                            <button class="accordion-button collapsed bg-light fw-bold text-secondary py-3 border-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHistorial" style="box-shadow: none;">
                                <i class="fas fa-history me-2 text-primary"></i> Ver Historial de Abonos (@(abonos?.Count ?? 0))
                            </button>
                        </h2>
                        <div id="collapseHistorial" class="accordion-collapse collapse" data-bs-parent="#accordionHistorial">
                            <div class="accordion-body p-0 border-top">
                                @if (abonos == null)
                                {
                                    <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
                                }
                                else if (!abonos.Any())
                                {
                                    <div class="text-center py-4 text-muted bg-white">No hay abonos registrados en este crédito.</div>
                                }
                                else
                                {
                                    <div class="table-responsive bg-white" style="max-height: 200px; overflow-y: auto;">
                                        <table class="table table-hover align-middle mb-0 text-sm">
                                            <thead class="bg-light sticky-top">
                                                <tr>
                                                    <th class="ps-4 small text-muted text-uppercase border-0">Fecha</th>
                                                    <th class="small text-muted text-uppercase border-0">Método</th>
                                                    <th class="text-end pe-4 small text-muted text-uppercase border-0">Abono (C$)</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var a in abonos)
                                                {
                                                    <tr>
                                                        <td class="ps-4 py-3 border-bottom-0">@a.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                                        <td class="py-3 border-bottom-0">
                                                            <span class="badge bg-secondary">@(metodosPago?.FirstOrDefault(m => m.IdMetodo == a.IdMetodoPago)?.Nombre ?? "Pago")</span>
                                                        </td>
                                                        <td class="text-end pe-4 py-3 fw-bold text-success border-bottom-0">@AppState.CurrencySymbol @a.Monto.ToString("N2")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public Credito Credito { get; set; } = null!;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnAbonoRegistered { get; set; }

    private List<CreditoAbono>? abonos;
    private List<MetodosPago>? metodosPago;
    
    // El monto exacto que se va a restar a la deuda.
    private decimal montoAbonarDeuda;
    public decimal MontoAbonarDeuda 
    {
        get => montoAbonarDeuda;
        set 
        {
            montoAbonarDeuda = value;
            UpdateSuggestedAmount();
        }
    }

    private PaymentInput currentPayment = new PaymentInput();
    private string MonedaVuelto = "NIO";
    private bool isProcessing = false;

    private decimal TotalPagado 
    {
        get 
        {
            if (currentPayment.Monto <= 0) return 0;
            var metodo = metodosPago?.FirstOrDefault(m => m.IdMetodo == currentPayment.IdMetodoPago);
            if (metodo == null) return 0;

            string paymentCurrency = metodo.IdMonedaNavigation?.Codigo ?? (metodo.Nombre.Contains("USD") ? "USD" : "NIO");
            string baseCurrency = AppState.CurrencyCode;
            
            decimal tasaCambio = 1m;
            decimal montoEnMonedaBase = currentPayment.Monto;

            if (baseCurrency == "NIO" && paymentCurrency == "USD")
            {
                // Usamos ExchangeRateBuy porque el cliente nos está entregando USD para cubrir deuda en NIO (compramos sus USD)
                tasaCambio = AppState.ExchangeRateBuy; 
                montoEnMonedaBase = currentPayment.Monto * tasaCambio;
            }
            else if (baseCurrency == "USD" && paymentCurrency == "NIO")
            {
                tasaCambio = AppState.ExchangeRateSell;
                montoEnMonedaBase = currentPayment.Monto / tasaCambio;
            }

            return montoEnMonedaBase;
        }
    }

    private decimal SaldoRestante => MontoAbonarDeuda - TotalPagado;

    protected override async Task OnInitializedAsync()
    {
        MontoAbonarDeuda = Credito.SaldoPendiente;
        metodosPago = await CheckoutService.GetMetodosPagoAsync();
        currentPayment.TasaCambio = AppState.ExchangeRateSell;
        
        if (metodosPago.Any())
        {
            var defaultMethod = metodosPago.FirstOrDefault(m => m.IdMonedaNavigation?.Codigo == AppState.CurrencyCode)
                                ?? metodosPago.FirstOrDefault(m => m.Nombre.Contains(AppState.CurrencyCode, StringComparison.OrdinalIgnoreCase));
            currentPayment.IdMetodoPago = defaultMethod != null ? defaultMethod.IdMetodo : metodosPago.First().IdMetodo;
        }

        UpdateSuggestedAmount();
        await LoadAbonos();
    }

    private async Task LoadAbonos()
    {
        abonos = await CreditoService.GetHistorialAbonosAsync(Credito.IdCredito);
    }

    private void UpdateSuggestedAmount()
    {
        if (MontoAbonarDeuda <= 0) 
        {
            currentPayment.Monto = 0;
            return;
        }

        var metodo = metodosPago?.FirstOrDefault(m => m.IdMetodo == currentPayment.IdMetodoPago);
        if (metodo == null) return;

        string paymentCurrency = metodo.IdMonedaNavigation?.Codigo ?? (metodo.Nombre.Contains("USD") ? "USD" : "NIO");
        string baseCurrency = AppState.CurrencyCode;

        if (baseCurrency == "NIO" && paymentCurrency == "USD")
            currentPayment.Monto = Math.Round(MontoAbonarDeuda / AppState.ExchangeRateBuy, 2);
        else if (baseCurrency == "USD" && paymentCurrency == "NIO")
            currentPayment.Monto = Math.Round(MontoAbonarDeuda * AppState.ExchangeRateSell, 2);
        else
            currentPayment.Monto = Math.Round(MontoAbonarDeuda, 2);
    }

    private async Task RegistrarAbono()
    {
        if (MontoAbonarDeuda <= 0 || MontoAbonarDeuda > Credito.SaldoPendiente)
        {
            ToastService.ShowWarning("Monto a abonar es inválido. Debe ser mayor a 0 y no exceder el saldo pendiente.");
            return;
        }
        if (currentPayment.IdMetodoPago == 0)
        {
            ToastService.ShowWarning("Seleccione un método de pago.");
            return;
        }
        if (SaldoRestante > 0)
        {
            ToastService.ShowWarning("El dinero recibido no es suficiente para cubrir el monto que desea abonar.");
            return;
        }

        var metodoSelec = metodosPago?.FirstOrDefault(m => m.IdMetodo == currentPayment.IdMetodoPago);
        string paymentCurrency = metodoSelec?.IdMonedaNavigation?.Codigo ?? (metodoSelec?.Nombre.Contains("USD") == true ? "USD" : "NIO");
        bool isUsdMethod = paymentCurrency == "USD";

        decimal vueltoBase = SaldoRestante < 0 ? Math.Abs(SaldoRestante) : 0;
        decimal vueltoMostrado = 0;
        if (SaldoRestante < 0)
        {
            vueltoMostrado = MonedaVuelto == "USD" ? 
                (AppState.CurrencyCode == "USD" ? Math.Abs(SaldoRestante) : Math.Abs(SaldoRestante) / AppState.ExchangeRateSell) : 
                (AppState.CurrencyCode == "NIO" ? Math.Abs(SaldoRestante) : Math.Abs(SaldoRestante) * AppState.ExchangeRateBuy);
            vueltoMostrado = Math.Round(vueltoMostrado, 2);
        }

        isProcessing = true;
        try
        {
            // Se utiliza el ID del usuario en sesión
            var abono = await CreditoService.RegistrarAbonoAsync(
                Credito.IdCredito, 
                UserSession.UserId ?? 1, 
                currentPayment.IdMetodoPago, 
                MontoAbonarDeuda, 
                currentPayment.Monto, 
                isUsdMethod ? (AppState.CurrencyCode == "USD" ? AppState.ExchangeRateSell : AppState.ExchangeRateBuy) : 1m, 
                vueltoBase, 
                vueltoMostrado,
                currentPayment.Referencia ?? "Abono",
                MonedaVuelto);
            
            ToastService.ShowSuccess("Abono registrado correctamente");
            
            // Imprimir Ticket
            if (!string.IsNullOrEmpty(AppState.PrinterName))
            {
                var ticketInfo = new {
                    nombreNegocio = AppState.BusinessName,
                    ruc = AppState.BusinessRuc,
                    direccion = AppState.BusinessAddress,
                    telefono = AppState.BusinessPhone,
                    abrirCajon = (metodoSelec?.Nombre.Contains("Efectivo", StringComparison.OrdinalIgnoreCase) == true) && AppState.OpenCashDrawer,
                    numeroCredito = Credito.IdCredito.ToString(),
                    facturaReferencia = Credito.Venta?.NumeroFactura ?? "N/A",
                    cliente = Credito.Venta?.IdPersonaNavigation?.NombreCompleto ?? Credito.Persona?.NombreCompleto ?? "Cliente",
                    fecha = abono.Fecha.ToString("dd/MM/yyyy HH:mm"),
                    saldoAnterior = Credito.SaldoPendiente,
                    montoAbonado = MontoAbonarDeuda,
                    nuevoSaldo = Credito.SaldoPendiente - MontoAbonarDeuda,
                    simboloMoneda = AppState.CurrencySymbol
                };
                
                await JS.InvokeVoidAsync("qzPrintAbono", ticketInfo, AppState.PrinterName);
            }

            // Actualizar localmente el saldo
            Credito.SaldoPendiente -= MontoAbonarDeuda;
            MontoAbonarDeuda = Credito.SaldoPendiente;
            UpdateSuggestedAmount();
            
            await LoadAbonos();
            await OnAbonoRegistered.InvokeAsync();
            
            if (Credito.SaldoPendiente <= 0)
            {
                await OnClose.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Error: " + ex.Message);
        }
        finally
        {
            isProcessing = false;
        }
    }
}
