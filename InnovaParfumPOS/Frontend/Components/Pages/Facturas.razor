@page "/facturas"
@using Microsoft.EntityFrameworkCore
@inject InnovaParfumDbContext DbContext
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@inject UserSession UserSession
@inject AppState AppState
@inject InnovaParfumPOS.Backend.Services.ICheckoutService CheckoutService

<PageTitle>Facturas - INNOVAPARFUM</PageTitle>

<div class="cli-container">
    <!-- Header -->
    <div class="cli-header">
        <div class="inv-title-group">
            <h2>Historial de Facturas</h2>
            <p>Consulta de ventas realizadas y reimpresión</p>
        </div>
    </div>

    <!-- Filters -->
    <div class="cli-search-bar d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center gap-2">
                <label class="fw-bold small text-muted mb-0">Desde:</label>
                <input type="date" class="form-control form-control-sm rounded-pill" @bind="startDate" />
            </div>
            <div class="d-flex align-items-center gap-2">
                <label class="fw-bold small text-muted mb-0">Hasta:</label>
                <input type="date" class="form-control form-control-sm rounded-pill" @bind="endDate" />
            </div>
            <div class="d-flex align-items-center gap-2">
                <select class="form-select form-select-sm rounded-pill" @bind="filterTipoVenta">
                    <option value="">Tipo Venta (Todos)</option>
                    @if(tiposVenta != null)
                    {
                        foreach(var t in tiposVenta)
                        {
                            <option value="@t.IdTipoVenta">@t.Descripcion</option>
                        }
                    }
                </select>
            </div>
            <div class="d-flex align-items-center gap-2">
                <select class="form-select form-select-sm rounded-pill" @bind="filterCondicion">
                    <option value="">Condición (Todas)</option>
                    @if(condicionesPago != null)
                    {
                        foreach(var c in condicionesPago)
                        {
                            <option value="@c.IdCondicion">@c.Descripcion</option>
                        }
                    }
                </select>
            </div>
            <button class="btn btn-primary btn-sm rounded-pill px-3" @onclick="LoadData">
                <i class="fas fa-filter me-1"></i> Filtrar
            </button>
        </div>

        <!-- Barra de Búsqueda -->
        <div class="search-box-container" style="min-width: 300px;">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white border-end-0 rounded-start-pill border-secondary border-opacity-25">
                    <i class="fas fa-search text-muted"></i>
                </span>
                <input type="text" class="form-control border-start-0 rounded-end-pill border-secondary border-opacity-25" 
                       placeholder="Buscar factura o cliente..." 
                       @bind="searchQuery" @bind:event="oninput" @onkeyup="HandleKeyUp" />
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="cli-table-card">
        <table class="pos-table">
            <thead>
                <tr>
                    <th>N° Factura</th>
                    <th>Fecha / Hora</th>
                    <th>Cliente</th>
                    <th>Vendedor</th>
                    <th>Tipo Venta</th>
                    <th>Condición</th>
                    <th>Total</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (ventas == null)
                {
                    <tr><td colspan="8" class="text-center py-5"><div class="spinner-border text-primary"></div></td></tr>
                }
                else if (!ventas.Any())
                {
                    <tr><td colspan="8" class="text-center py-5 text-muted">No se encontraron ventas en este rango de fechas.</td></tr>
                }
                else
                {
                    @foreach (var v in ventas.Skip((currentPage - 1) * pageSize).Take(pageSize))
                    {
                        <tr class="@(v.Anulada ? "table-danger text-muted" : "")" style="@(v.Anulada ? "opacity: 0.8;" : "")">
                            <td>
                                <span class="fw-bold @(v.Anulada ? "text-danger text-decoration-line-through" : "text-primary")">
                                    @v.NumeroFactura
                                </span>
                            </td>
                            <td class="@(v.Anulada ? "text-decoration-line-through" : "")">@v.FechaVenta.ToString("dd/MM/yyyy hh:mm tt")</td>
                            <td class="@(v.Anulada ? "text-decoration-line-through" : "")">@(v.IdPersonaNavigation != null ? v.IdPersonaNavigation.NombreCompleto : "Cliente General")</td>
                            <td class="@(v.Anulada ? "text-decoration-line-through" : "")">@(v.IdUsuarioNavigation != null ? v.IdUsuarioNavigation.Username : "N/A")</td>
                            <td>
                                @if (v.IdTipoVentaNavigation != null)
                                {
                                    <span class="badge rounded-pill @(v.IdTipoVentaNavigation.Descripcion.ToUpper() == "MAYORISTA" ? "bg-primary text-white" : "bg-success text-white") px-3">
                                        <i class="fas @(v.IdTipoVentaNavigation.Descripcion.ToUpper() == "MAYORISTA" ? "fa-boxes" : "fa-box") me-1"></i> @v.IdTipoVentaNavigation.Descripcion
                                    </span>
                                }
                            </td>
                            <td>
                                @if (v.IdCondicionPagoNavigation != null)
                                {
                                    <span class="badge rounded-pill @(v.IdCondicionPagoNavigation.Descripcion.ToUpper() == "CONTADO" ? "bg-success" : "bg-warning text-dark") px-3">
                                        <i class="fas @(v.IdCondicionPagoNavigation.Descripcion.ToUpper() == "CONTADO" ? "fa-money-bill-wave" : "fa-hand-holding-usd") me-1"></i> @v.IdCondicionPagoNavigation.Descripcion
                                    </span>
                                }
                            </td>
                            <td class="fw-bold">
                                @if (v.Anulada)
                                {
                                    <span class="badge bg-danger px-3"><i class="fas fa-ban me-1"></i> ANULADA</span>
                                }
                                else
                                {
                                    @AppState.CurrencySymbol @v.TotalBase.ToString("N2")
                                }
                            </td>
                            <td class="text-end">
                                @if (v.FechaVenta.Date == DateTime.Today && !v.Anulada)
                                {
                                    <button class="btn btn-outline-danger btn-sm rounded-pill px-3 me-2" @onclick="() => StartReverso(v)" title="Reverso / Anulación">
                                        <i class="fas fa-undo-alt me-1"></i> Reverso
                                    </button>
                                }
                                <button class="btn btn-outline-primary btn-sm rounded-pill px-3" @onclick="() => ShowInvoiceDetails(v)">
                                    <i class="fas fa-print me-1"></i> Reimprimir Factura
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <!-- Paginación Premium tipo Carrusel -->
        @if (ventas != null && ventas.Count > pageSize)
        {
            var totalPages = (int)Math.Ceiling((double)ventas.Count / pageSize);
            <div class="pagination-container d-flex align-items-center p-3 border-top">
                <div class="flex-grow-1">
                    <span class="small text-muted">Mostrando @(Math.Min(ventas.Count, (currentPage - 1) * pageSize + 1)) a @(Math.Min(ventas.Count, currentPage * pageSize)) de @ventas.Count facturas</span>
                </div>
                <div class="pagination-carousel-container">
                    <ul class="pagination pagination-premium mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetPage(currentPage - 1)" title="Anterior">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                        </li>
                        
                        @{
                            // Lógica de ventana deslizante (Carrusel de 6 números)
                            int maxVisible = 6;
                            int startPage = Math.Max(1, Math.Min(currentPage - 2, totalPages - maxVisible + 1));
                            int endPage = Math.Min(totalPages, startPage + maxVisible - 1);
                            
                            // Re-ajustar si estamos cerca del final
                            if (totalPages > maxVisible && endPage == totalPages) startPage = Math.Max(1, totalPages - maxVisible + 1);

                            for (int i = startPage; i <= endPage; i++)
                            {
                                var pageNum = i;
                                <li class="page-item @(currentPage == pageNum ? "active" : "") page-item-animated" @key="pageNum">
                                    <button class="page-link" @onclick="() => SetPage(pageNum)">@pageNum</button>
                                </li>
                            }

                            // Mostrar Elipsis y Última Página si es necesario
                            if (endPage < totalPages)
                            {
                                if (endPage < totalPages - 1)
                                {
                                    <li class="pagination-ellipsis">...</li>
                                }
                                <li class="page-item @(currentPage == totalPages ? "active" : "") page-item-animated">
                                    <button class="page-link" @onclick="() => SetPage(totalPages)">@totalPages</button>
                                </li>
                            }
                        }

                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetPage(currentPage + 1)" title="Siguiente">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </li>
                    </ul>
                </div>
                <div class="flex-grow-1 text-end"></div> <!-- Espaciador para centrar el carrusel -->
            </div>
        }
    </div>
</div>

<!-- Modal: Vista Previa de Factura -->
@if (showPreviewModal && selectedVenta != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
            <div class="modal-content shadow-lg border-0" style="border-radius: 12px;">
                <div class="modal-header border-0 pb-0">
                    <h5 class="fw-bold m-0"><i class="fas fa-file-invoice me-2"></i>Vista Previa</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body py-3">
                    <!-- Ticket Layout for Print -->
                    <div class="print-section p-3 bg-white text-dark" style="font-family: 'Courier New', Courier, monospace; font-size: 13px;">
                        <div class="text-center mb-3">
                            <img src="@AppState.BusinessLogo" alt="Logo" style="max-width: 80px; height: auto; margin-bottom: 10px; border-radius: 8px;" />
                            <h5 class="fw-bold m-0" style="font-family: 'Outfit', sans-serif;">@AppState.BusinessName</h5>
                            <p class="small m-0">@AppState.BusinessRuc</p>
                            @if (!string.IsNullOrEmpty(AppState.BusinessAddress))
                            {
                                <p class="x-small m-0" style="font-size: 10px;">@AppState.BusinessAddress</p>
                            }
                            <hr style="border-top: 1px dashed #000; margin: 10px 0;" />
                        </div>

                        <div class="mb-2">
                            <div><strong>Factura:</strong> @selectedVenta.NumeroFactura</div>
                            <div><strong>Fecha:</strong> @selectedVenta.FechaVenta.ToString("dd/MM/yyyy HH:mm")</div>
                            <div><strong>Cliente:</strong> @(selectedVenta.IdPersonaNavigation != null ? selectedVenta.IdPersonaNavigation.NombreCompleto : "Cliente General")</div>
                            <div><strong>Cajero:</strong> @(selectedVenta.IdUsuarioNavigation != null ? selectedVenta.IdUsuarioNavigation.Username : "N/A")</div>
                            @if(selectedVenta.IdTipoVentaNavigation != null)
                            {
                                <div><strong>Tipo Venta:</strong> @selectedVenta.IdTipoVentaNavigation.Descripcion</div>
                            }
                            @if(selectedVenta.IdCondicionPagoNavigation != null)
                            {
                                <div><strong>Condición:</strong> @selectedVenta.IdCondicionPagoNavigation.Descripcion</div>
                            }
                        </div>

                        <hr style="border-top: 1px dashed #000; margin: 10px 0;" />

                        <table class="w-100 mb-2" style="font-size: 12px;">
                            <thead>
                                <tr class="border-bottom">
                                    <th class="text-start">Cant</th>
                                    <th class="text-start">Desc</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var groupedDetails = selectedVenta.VentaDetalles
                                        .GroupBy(d => new { d.DescripcionSnap, d.PrecioUnitarioBase })
                                        .Select(g => new {
                                            Cantidad = g.Sum(x => x.Cantidad),
                                            Descripcion = g.Key.DescripcionSnap,
                                            Total = g.Sum(x => x.SubtotalBase)
                                        });

                                    foreach (var d in groupedDetails)
                                    {
                                            <tr>
                                                <td class="align-top">@d.Cantidad</td>
                                                <td>@d.Descripcion</td>
                                                <td class="text-end align-top">@AppState.CurrencySymbol @d.Total.ToString("N2")</td>
                                            </tr>
                                    }
                                }
                            </tbody>
                        </table>

                        <hr style="border-top: 1px dashed #000; margin: 10px 0;" />

                        <div class="d-flex justify-content-between fw-bold mb-1">
                            <span>Subtotal:</span>
                            <span>@AppState.CurrencySymbol @selectedVenta.SubtotalBase.ToString("N2")</span>
                        </div>
                        @if (selectedVenta.DescuentoBase > 0)
                        {
                            <div class="d-flex justify-content-between mb-1">
                                <span>Descuento:</span>
                                <span>-@AppState.CurrencySymbol @selectedVenta.DescuentoBase.ToString("N2")</span>
                            </div>
                        }
                        <div class="d-flex justify-content-between fw-bold fs-6">
                            <span>TOTAL:</span>
                            <span>@AppState.CurrencySymbol @selectedVenta.TotalBase.ToString("N2")</span>
                        </div>

                        @if (selectedVenta.Pagos != null && selectedVenta.Pagos.Any())
                        {
                            <div class="mt-2 pt-2" style="border-top: 1px dashed #000;">
                                <div class="fw-bold mb-1">Pagos:</div>
                                @foreach (var p in selectedVenta.Pagos)
                                {
                                    <div class="d-flex justify-content-between">
                                        <span>@(p.IdMetodoPagoNavigation?.Nombre ?? "Efectivo")</span>
                                        <span>@((p.IdMetodoPagoNavigation?.Nombre ?? "").Contains("USD") ? "$" : "C$") @p.MontoPagado.ToString("N2")</span>
                                    </div>
                                }
                            </div>
                        }

                        @{
                            var totalVueltoMostrado = selectedVenta.Pagos?.Sum(p => p.VueltoMostrado) ?? 0;
                            if (totalVueltoMostrado > 0 && selectedVenta.MonedaVuelto != null)
                            {
                                var vueltoText = selectedVenta.MonedaVuelto == "USD" ? "Vuelto en USD" : "Vuelto en C$";
                                var vueltoAmount = selectedVenta.MonedaVuelto == "USD" ? $"$ {totalVueltoMostrado.ToString("N2")}" : $"C$ {totalVueltoMostrado.ToString("N2")}";

                                <div class="mt-2 pt-2" style="border-top: 1px dashed #000;">
                                    <div class="d-flex justify-content-between fw-bold">
                                        <span>@vueltoText:</span>
                                        <span>@vueltoAmount</span>
                                    </div>
                                </div>
                            }
                        }

                        <hr style="border-top: 1px dashed #000; margin: 15px 0 5px 0;" />
                        <div class="text-center small mt-2">
                            <p class="m-0">@AppState.TicketMessage</p>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 justify-content-center">
                    <button type="button" class="btn btn-light rounded-pill px-4" @onclick="CloseModal">Cerrar</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4" @onclick="PrintInvoice">
                        <i class="fas fa-print me-2"></i> Imprimir
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Reverso de Transacción -->
@if (showReversoModal && reversoVenta != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg border-0" style="border-radius: 12px;">
                <div class="modal-header border-0 pb-0">
                    <h5 class="fw-bold m-0 text-danger"><i class="fas fa-undo-alt me-2"></i>Reverso de Transacción (FAC-@reversoVenta.NumeroFactura)</h5>
                    <button type="button" class="btn-close" @onclick="() => showReversoModal = false"></button>
                </div>
                <div class="modal-body pt-3">
                    <p class="text-muted small mb-4">Seleccione el tipo de reverso e ingrese la justificación. Esta acción afectará el inventario y el cuadre de caja de su turno actual.</p>
                    
                    <div class="mb-4 d-flex gap-3">
                        <div class="form-check form-check-inline p-3 border rounded @(!isReversoParcial ? "border-danger bg-danger bg-opacity-10" : "")" style="cursor:pointer;" @onclick="() => isReversoParcial = false">
                            <input class="form-check-input" type="radio" name="reversoType" id="totalRev" checked="@(!isReversoParcial)" />
                            <label class="form-check-label fw-bold ms-2" for="totalRev">Reverso Total (Anular toda la factura)</label>
                        </div>
                        <div class="form-check form-check-inline p-3 border rounded @(isReversoParcial ? "border-primary bg-primary bg-opacity-10" : "")" style="cursor:pointer;" @onclick="() => isReversoParcial = true">
                            <input class="form-check-input" type="radio" name="reversoType" id="parcialRev" checked="@(isReversoParcial)" />
                            <label class="form-check-label fw-bold ms-2" for="parcialRev">Devolución Parcial (Seleccionar Productos)</label>
                        </div>
                    </div>

                    @if (isReversoParcial)
                    {
                        <div class="mb-4">
                            <h6 class="fw-bold mb-3">Seleccione los productos a devolver:</h6>
                            <div class="table-responsive" style="max-height: 250px;">
                                <table class="table table-sm table-hover align-middle">
                                    <thead class="table-light sticky-top">
                                        <tr>
                                            <th style="width: 40px;"></th>
                                            <th>Producto</th>
                                            <th>Cant.</th>
                                            <th>Subtotal</th>
                                            <th>Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach(var det in reversoDetalles)
                                        {
                                            <tr>
                                                <td>
                                                    @if (!det.Devuelto)
                                                    {
                                                        <input class="form-check-input" type="checkbox" checked="@selectedDetallesParaReverso.Contains(det.IdDetalle)" @onchange="(e) => ToggleDetalleReverso(det.IdDetalle, e.Value)" />
                                                    }
                                                </td>
                                                <td>@det.DescripcionSnap</td>
                                                <td>@det.Cantidad</td>
                                                <td>@AppState.CurrencySymbol @det.SubtotalBase.ToString("N2")</td>
                                                <td>
                                                    @if(det.Devuelto) { <span class="badge bg-secondary">Ya devuelto</span> }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold">Motivo / Justificación:</label>
                        <textarea class="form-control rounded" rows="3" @bind="reversoMotivo" placeholder="Escriba la razón de la devolución o anulación..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" @onclick="() => showReversoModal = false">Cancelar</button>
                    <button type="button" class="btn btn-danger rounded-pill px-4 fw-bold" @onclick="ExecuteReverso">
                        <i class="fas fa-check-circle me-1"></i> Confirmar Reverso
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    /* Estilos para impresión */
    @@media print {
        body * {
            visibility: hidden;
        }
        .print-section, .print-section * {
            visibility: visible;
        }
        .print-section {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            padding: 0;
            margin: 0;
        }
        .modal-backdrop, .modal {
            background: none !important;
            position: static !important;
        }
    }
</style>

@code {
    private DateTime startDate = DateTime.Today;
    private DateTime endDate = DateTime.Today;
    private int? filterTipoVenta = null;
    private int? filterCondicion = null;
    private string searchQuery = "";
    private List<Venta>? ventas;
    private List<TiposVentum>? tiposVenta;
    private List<CondicionesPago>? condicionesPago;
    private Venta? selectedVenta;
    private bool showPreviewModal = false;

    // Variables Reverso
    private Venta? reversoVenta;
    private bool showReversoModal = false;
    private string reversoMotivo = "";
    private bool isReversoParcial = false;
    private List<VentaDetalle> reversoDetalles = new();
    private List<int> selectedDetallesParaReverso = new();

    private int currentPage = 1;
    private int pageSize = 10;

    protected override async Task OnInitializedAsync()
    {
        tiposVenta = await DbContext.TiposVenta.Where(t => t.Activo).ToListAsync();
        condicionesPago = await DbContext.CondicionesPagos.Where(c => c.Activo).ToListAsync();
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            currentPage = 1; // Reset page on filter
            ventas = null;
            StateHasChanged();

            // Ajustar fechas para cubrir todo el día
            var start = startDate.Date;
            var end = endDate.Date.AddDays(1).AddTicks(-1);

            var query = DbContext.Ventas.AsNoTracking()
                .Include(v => v.IdPersonaNavigation)
                .Include(v => v.IdUsuarioNavigation)
                .Include(v => v.VentaDetalles)
                .Include(v => v.IdTipoVentaNavigation)
                .Include(v => v.IdCondicionPagoNavigation)
                .Include(v => v.Pagos)
                    .ThenInclude(p => p.IdMetodoPagoNavigation)
                .Where(v => v.FechaVenta >= start && v.FechaVenta <= end);

            if (filterTipoVenta.HasValue)
            {
                query = query.Where(v => v.IdTipoVenta == filterTipoVenta.Value);
            }
            if (filterCondicion.HasValue)
            {
                query = query.Where(v => v.IdCondicionPago == filterCondicion.Value);
            }

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                query = query.Where(v => (v.NumeroFactura != null && v.NumeroFactura.Contains(searchQuery)) || 
                                       (v.IdPersonaNavigation != null && v.IdPersonaNavigation.NombreCompleto != null && v.IdPersonaNavigation.NombreCompleto.Contains(searchQuery)));
            }

            ventas = await query.OrderByDescending(v => v.FechaVenta).ToListAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Error al cargar facturas: " + ex.Message);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void ShowInvoiceDetails(Venta venta)
    {
        selectedVenta = venta;
        showPreviewModal = true;
    }

    private void SetPage(int page)
    {
        currentPage = page;
        StateHasChanged();
    }

    private void CloseModal()
    {
        showPreviewModal = false;
        selectedVenta = null;
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadData();
        }
    }
    
    private void StartReverso(Venta v)
    {
        reversoVenta = v;
        reversoMotivo = "";
        isReversoParcial = false;
        reversoDetalles = v.VentaDetalles.ToList();
        selectedDetallesParaReverso.Clear();
        showReversoModal = true;
    }

    private void ToggleDetalleReverso(int idDetalle, object? isCheckedObj)
    {
        bool isChecked = false;
        if (isCheckedObj is bool b) isChecked = b;
        else if (isCheckedObj is string s && bool.TryParse(s, out var sb)) isChecked = sb;

        if (isChecked && !selectedDetallesParaReverso.Contains(idDetalle))
        {
            selectedDetallesParaReverso.Add(idDetalle);
        }
        else if (!isChecked && selectedDetallesParaReverso.Contains(idDetalle))
        {
            selectedDetallesParaReverso.Remove(idDetalle);
        }
    }

    private async Task ExecuteReverso()
    {
        if (string.IsNullOrWhiteSpace(reversoMotivo))
        {
            ToastService.ShowError("Debe ingresar un motivo para el reverso.");
            return;
        }

        if (isReversoParcial && !selectedDetallesParaReverso.Any())
        {
            ToastService.ShowError("Debe seleccionar al menos un producto para devolver.");
            return;
        }

        try
        {
            string? jsonDetalles = null;
            if (isReversoParcial)
            {
                jsonDetalles = System.Text.Json.JsonSerializer.Serialize(selectedDetallesParaReverso);
            }

            await CheckoutService.ReversarTransaccionAsync(reversoVenta!.IdVenta, UserSession.UserId ?? 0, reversoMotivo, jsonDetalles);
            ToastService.ShowSuccess("Transacción reversada con éxito.");
            showReversoModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
    }

    private async Task PrintInvoice()
    {
        if (selectedVenta == null) return;

            var totalVueltoMostrado = selectedVenta.Pagos?.Sum(p => p.VueltoMostrado) ?? 0;
            var hayVuelto = totalVueltoMostrado > 0;
            var vueltoText = hayVuelto ? (selectedVenta.MonedaVuelto == "USD" ? "Vuelto en USD" : "Vuelto en C$") : "";
            var vueltoAmount = hayVuelto ? 
                (selectedVenta.MonedaVuelto == "USD" ? $"$ {totalVueltoMostrado.ToString("N2")}" : $"C$ {totalVueltoMostrado.ToString("N2")}") : "";

            var invoiceData = new
            {
                numeroFactura = selectedVenta.NumeroFactura,
                fecha = selectedVenta.FechaVenta.ToString("dd/MM/yyyy HH:mm"),
                nombreNegocio = AppState.BusinessName,
                ruc = AppState.BusinessRuc,
                direccion = AppState.BusinessAddress,
                telefono = AppState.BusinessPhone,
                logoPath = AppState.BusinessLogo,
                mensajeTicket = AppState.TicketMessage,
                abrirCajon = false, // Nunca abrir caja al reimprimir
                simboloMoneda = AppState.CurrencySymbol + " ",
                tipoVenta = selectedVenta.IdTipoVentaNavigation?.Descripcion ?? "NORMAL",
                condicionPago = selectedVenta.IdCondicionPagoNavigation?.Descripcion ?? "CONTADO",
                cliente = selectedVenta.IdPersonaNavigation?.NombreCompleto ?? "Cliente General",
                vendedor = selectedVenta.IdUsuarioNavigation?.Username ?? "N/A",
                subtotal = selectedVenta.SubtotalBase,
                descuento = selectedVenta.DescuentoBase,
                total = selectedVenta.TotalBase,
                vueltoText = vueltoText,
                vueltoAmount = vueltoAmount,
                metodosPago = selectedVenta.Pagos.Select(p => new {
                metodo = p.IdMetodoPagoNavigation?.Nombre ?? "Efectivo",
                monto = p.MontoPagado,
                simbolo = (p.IdMetodoPagoNavigation?.Nombre ?? "").Contains("USD") ? "$" : "C$" // Simplificación, mejor sería leer la moneda
            }).ToList(),
            detalles = selectedVenta.VentaDetalles
                .GroupBy(d => new { d.DescripcionSnap, d.PrecioUnitarioBase })
                .Select(g => new {
                    cantidad = g.Sum(x => x.Cantidad),
                    descripcion = g.Key.DescripcionSnap,
                    total = g.Sum(x => x.SubtotalBase)
                }).ToList()
        };

        try
        {
            await JSRuntime.InvokeVoidAsync("qzPrintInvoice", invoiceData, AppState.PrinterName);
            ToastService.ShowSuccess("Comprobante enviado a la impresora.");
        }

        catch (Exception ex)
        {
            ToastService.ShowError("Error al imprimir: " + ex.Message);
        }
    }
}


