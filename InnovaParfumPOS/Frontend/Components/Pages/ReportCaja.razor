@using InnovaParfumPOS.Backend.Services
@using InnovaParfumPOS.Backend.Models
@inject InnovaParfumPOS.Backend.Services.AppState AppState
@inject IReportService ReportService

@if (arqueos == null)
{
    <div class="text-center py-5">
        <div class="skeleton" style="height: 200px; border-radius: 20px;"></div>
    </div>
}
else
{
    <div class="report-card mb-4 shadow-sm" style="border-radius: 16px; border: none; overflow: hidden;">
        <div class="report-card-title px-4 py-3 bg-white fw-bold" style="font-size: 1.1rem; color: var(--text-dark); border-bottom: 1px solid #f1f3f5;">
            <span>
                <i class="fas fa-audit me-2 text-primary"></i>Auditoría de Arqueos y Turnos
            </span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0" style="font-size: 0.82rem;">
                <thead style="background: #f8f9fa;">
                    <tr>
                        <th colspan="4" class="text-center py-2 text-uppercase small fw-bold text-muted border-end">Identificación</th>
                        <th colspan="3" class="text-center py-2 text-uppercase small fw-bold text-muted border-end" style="background: rgba(0,0,0,0.02)">Ventas</th>
                        <th colspan="3" class="text-center py-2 text-uppercase small fw-bold text-muted border-end">Cobros Ventas</th>
                        <th colspan="3" class="text-center py-2 text-uppercase small fw-bold text-muted border-end" style="background: rgba(0,0,0,0.02)">Cobros Abonos</th>
                        <th colspan="4" class="text-center py-2 text-uppercase small fw-bold text-muted border-end">Otros Movimientos</th>
                        <th colspan="4" class="text-center py-2 text-uppercase small fw-bold text-muted" style="background: rgba(0,0,0,0.02)">Caja</th>
                    </tr>
                    <tr style="border-bottom: 2px solid #e9ecef;">
                        <!-- Identificación -->
                        <th class="ps-3 py-2 text-uppercase small fw-bold text-muted text-nowrap">Turno</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-nowrap">Cajero</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-nowrap">Moneda</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap border-end">Inicial</th>
                        <!-- Ventas -->
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap" style="background: rgba(0,0,0,0.02)">Efectuadas</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap" style="background: rgba(0,0,0,0.02)">Anuladas</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap border-end" style="background: rgba(0,0,0,0.02)">Netas</th>
                        <!-- Cobros Ventas -->
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap">Efectivo</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap">Transf.</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap border-end">Tarjeta</th>
                        <!-- Cobros Abonos -->
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap" style="background: rgba(0,0,0,0.02)">Efectivo</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap" style="background: rgba(0,0,0,0.02)">Transf.</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap border-end" style="background: rgba(0,0,0,0.02)">Tarjeta</th>
                        <!-- Otros Mov. -->
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap">Ingresos</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap">Retiros</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap">Reversos</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap border-end">Vuelto</th>
                        <!-- Caja -->
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap" style="background: rgba(0,0,0,0.02)">Teórico</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap" style="background: rgba(0,0,0,0.02)">Real</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap" style="background: rgba(0,0,0,0.02)">Diferencia</th>
                        <th class="pe-3 py-2 text-uppercase small fw-bold text-muted text-center" style="background: rgba(0,0,0,0.02)">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!arqueos.Any())
                    {
                        <tr>
                            <td colspan="21" class="text-center py-5 text-muted">
                                <i class="fas fa-receipt fa-2x mb-2 opacity-50"></i>
                                <p class="mb-0">No hay registros para este período</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var a in arqueos.Skip((currentPage - 1) * pageSize).Take(pageSize))
                        {
                            <!-- Fila de CÓRDOBAS -->
                            <tr style="transition: background-color 0.2s; cursor: pointer;" 
                                class="@(selectedTurnoId == a.IdTurno ? "table-primary" : "")"
                                @onclick="() => SelectTurno(a.IdTurno)">
                                
                                <!-- IDENTIFICACIÓN -->
                                <td rowspan="2" class="ps-3 py-2 text-nowrap align-middle border-end">
                                    <div class="d-flex flex-column">
                                        <span class="fw-bold text-primary">#@a.IdTurno</span>
                                        <span class="small text-muted">@a.Apertura.ToString("dd/MM")</span>
                                    </div>
                                </td>
                                <td rowspan="2" class="px-2 py-2 fw-semibold text-nowrap align-middle border-end">
                                    <div class="d-flex flex-column">
                                        <span>@a.Usuario</span>
                                        @if (a.Cierre == null)
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary px-2 py-1 rounded-pill mt-1" style="font-size: 0.65rem;">EN CURSO</span>
                                        }
                                    </div>
                                </td>
                                
                                <td class="px-2 py-2 fw-bold text-nowrap" style="color: #495057;">C$ CORDOBAS</td>
                                <td class="px-2 py-2 text-end text-nowrap border-end">@a.MontoInicialNIO.ToString("N2")</td>
                                
                                <!-- VENTAS -->
                                @if (AppState.CurrencyCode == "NIO")
                                {
                                    <td class="px-2 py-2 text-end text-nowrap" style="background: rgba(0,0,0,0.02)">
                                        <div>@a.VentasEfectuadasBase.ToString("N2")</div>
                                        <div class="small text-muted">(@a.CantVentasEfectuadas vtas)</div>
                                    </td>
                                    <td class="px-2 py-2 text-end text-nowrap" style="background: rgba(0,0,0,0.02)">
                                        <div>@a.VentasAnuladasBase.ToString("N2")</div>
                                        <div class="small text-muted">(@a.CantVentasAnuladas anul)</div>
                                    </td>
                                    <td class="px-2 py-2 text-end text-nowrap border-end fw-bold text-primary" style="background: rgba(0,0,0,0.02)">
                                        @a.VentasNetasBase.ToString("N2")
                                    </td>
                                }
                                else
                                {
                                    <td class="px-2 py-2 text-center text-nowrap text-muted" style="background: rgba(0,0,0,0.02)">--</td>
                                    <td class="px-2 py-2 text-center text-nowrap text-muted" style="background: rgba(0,0,0,0.02)">--</td>
                                    <td class="px-2 py-2 text-center text-nowrap border-end text-muted" style="background: rgba(0,0,0,0.02)">--</td>
                                }
                                
                                <!-- COBROS VENTAS -->
                                <td class="px-2 py-2 text-end text-nowrap">@a.CobrosEfectivoNIO.ToString("N2")</td>
                                <td class="px-2 py-2 text-end text-nowrap">@a.CobrosTransferenciaNIO.ToString("N2")</td>
                                <td class="px-2 py-2 text-end text-nowrap border-end">@a.CobrosTarjetaNIO.ToString("N2")</td>
                                
                                <!-- COBROS ABONOS -->
                                <td class="px-2 py-2 text-end text-nowrap text-success" style="background: rgba(0,0,0,0.02)">@a.AbonosEfectivoNIO.ToString("N2")</td>
                                <td class="px-2 py-2 text-end text-nowrap text-success" style="background: rgba(0,0,0,0.02)">@a.AbonosTransferenciaNIO.ToString("N2")</td>
                                <td class="px-2 py-2 text-end text-nowrap text-success border-end" style="background: rgba(0,0,0,0.02)">@a.AbonosTarjetaNIO.ToString("N2")</td>
                                
                                <!-- OTROS MOVIMIENTOS -->
                                <td class="px-2 py-2 text-end text-nowrap text-success">@a.IngresosManualesNIO.ToString("N2")</td>
                                <td class="px-2 py-2 text-end text-nowrap text-danger">@a.RetirosManualesNIO.ToString("N2")</td>
                                <td class="px-2 py-2 text-end text-nowrap text-danger">@a.ReversosNIO.ToString("N2")</td>
                                <td class="px-2 py-2 text-end text-nowrap text-danger border-end">@a.VueltoNIO.ToString("N2")</td>
                                
                                <!-- CAJA -->
                                <td class="px-2 py-2 text-end fw-bold text-nowrap" style="background: rgba(0,0,0,0.02)">@a.SaldoTeoricoNIO.ToString("N2")</td>
                                <td class="px-2 py-2 text-end fw-semibold text-nowrap" style="background: rgba(0,0,0,0.02)">
                                    @(a.Cierre == null ? "--" : a.SaldoRealNIO?.ToString("N2"))
                                </td>
                                <td class="px-2 py-2 text-end fw-bold text-nowrap @(a.Cierre != null && a.DiferenciaNIO < 0 ? "text-danger" : a.DiferenciaNIO > 0 ? "text-warning" : "text-success")" style="background: rgba(0,0,0,0.02)">
                                    @(a.Cierre == null ? "--" : a.DiferenciaNIO?.ToString("N2"))
                                </td>
                                <td class="pe-3 py-2 text-center text-nowrap" style="background: rgba(0,0,0,0.02)">
                                    @if (a.Cierre != null)
                                    {
                                        @if (a.EstadoCuadreNIO == "FALTANTE") { <span class="badge bg-danger bg-opacity-10 text-danger px-2 py-1 rounded-pill">FALTANTE</span> }
                                        else if (a.EstadoCuadreNIO == "SOBRANTE") { <span class="badge bg-warning bg-opacity-10 text-warning px-2 py-1 rounded-pill">SOBRANTE</span> }
                                        else { <span class="badge bg-success bg-opacity-10 text-success px-2 py-1 rounded-pill">CUADRADO</span> }
                                    }
                                    else { <span class="badge bg-secondary bg-opacity-10 text-secondary px-2 py-1 rounded-pill">ABIERTO</span> }
                                </td>
                            </tr>
                            
                            <!-- Fila de DÓLARES -->
                            <tr style="transition: background-color 0.2s; cursor: pointer; border-bottom: 2px solid #dee2e6;" 
                                class="@(selectedTurnoId == a.IdTurno ? "table-primary" : "")"
                                @onclick="() => SelectTurno(a.IdTurno)">
                                
                                <td class="px-2 py-2 fw-bold text-nowrap text-muted">$ DOLARES</td>
                                <td class="px-2 py-2 text-end text-nowrap text-muted border-end">@a.MontoInicialUSD.ToString("N2")</td>
                                
                                <!-- VENTAS -->
                                @if (AppState.CurrencyCode == "USD")
                                {
                                    <td class="px-2 py-2 text-end text-nowrap text-muted" style="background: rgba(0,0,0,0.02)">
                                        <div>@a.VentasEfectuadasBase.ToString("N2")</div>
                                        <div class="small opacity-50">(@a.CantVentasEfectuadas vtas)</div>
                                    </td>
                                    <td class="px-2 py-2 text-end text-nowrap text-muted" style="background: rgba(0,0,0,0.02)">
                                        <div>@a.VentasAnuladasBase.ToString("N2")</div>
                                        <div class="small opacity-50">(@a.CantVentasAnuladas anul)</div>
                                    </td>
                                    <td class="px-2 py-2 text-end text-nowrap border-end fw-bold text-primary opacity-75" style="background: rgba(0,0,0,0.02)">
                                        @a.VentasNetasBase.ToString("N2")
                                    </td>
                                }
                                else
                                {
                                    <td class="px-2 py-2 text-center text-nowrap text-muted" style="background: rgba(0,0,0,0.02)">--</td>
                                    <td class="px-2 py-2 text-center text-nowrap text-muted" style="background: rgba(0,0,0,0.02)">--</td>
                                    <td class="px-2 py-2 text-center text-nowrap border-end text-muted" style="background: rgba(0,0,0,0.02)">--</td>
                                }
                                
                                <!-- COBROS VENTAS -->
                                <td class="px-2 py-2 text-end text-nowrap text-muted">@a.CobrosEfectivoUSD.ToString("N2")</td>
                                <td class="px-2 py-2 text-end text-nowrap text-muted">@a.CobrosTransferenciaUSD.ToString("N2")</td>
                                <td class="px-2 py-2 text-end text-nowrap text-muted border-end">@a.CobrosTarjetaUSD.ToString("N2")</td>
                                
                                <!-- COBROS ABONOS -->
                                <td class="px-2 py-2 text-end text-nowrap text-success opacity-75" style="background: rgba(0,0,0,0.02)">@a.AbonosEfectivoUSD.ToString("N2")</td>
                                <td class="px-2 py-2 text-end text-nowrap text-success opacity-75" style="background: rgba(0,0,0,0.02)">@a.AbonosTransferenciaUSD.ToString("N2")</td>
                                <td class="px-2 py-2 text-end text-nowrap text-success opacity-75 border-end" style="background: rgba(0,0,0,0.02)">@a.AbonosTarjetaUSD.ToString("N2")</td>
                                
                                <!-- OTROS MOVIMIENTOS -->
                                <td class="px-2 py-2 text-end text-nowrap text-success opacity-75">@a.IngresosManualesUSD.ToString("N2")</td>
                                <td class="px-2 py-2 text-end text-nowrap text-danger opacity-75">@a.RetirosManualesUSD.ToString("N2")</td>
                                <td class="px-2 py-2 text-end text-nowrap text-danger opacity-75">@a.ReversosUSD.ToString("N2")</td>
                                <td class="px-2 py-2 text-end text-nowrap text-danger opacity-75 border-end">@a.VueltoUSD.ToString("N2")</td>
                                
                                <!-- CAJA -->
                                <td class="px-2 py-2 text-end fw-bold text-nowrap text-muted" style="background: rgba(0,0,0,0.02)">@a.SaldoTeoricoUSD.ToString("N2")</td>
                                <td class="px-2 py-2 text-end fw-semibold text-nowrap text-muted" style="background: rgba(0,0,0,0.02)">
                                    @(a.Cierre == null ? "--" : a.SaldoRealUSD?.ToString("N2"))
                                </td>
                                <td class="px-2 py-2 text-end fw-bold text-nowrap @(a.Cierre != null && a.DiferenciaUSD < 0 ? "text-danger" : a.DiferenciaUSD > 0 ? "text-warning" : "text-success opacity-75")" style="background: rgba(0,0,0,0.02)">
                                    @(a.Cierre == null ? "--" : a.DiferenciaUSD?.ToString("N2"))
                                </td>
                                <td class="pe-3 py-2 text-center text-nowrap" style="background: rgba(0,0,0,0.02)">
                                    @if (a.Cierre != null)
                                    {
                                        @if (a.EstadoCuadreUSD == "FALTANTE") { <span class="badge bg-danger bg-opacity-10 text-danger px-2 py-1 rounded-pill">FALTANTE</span> }
                                        else if (a.EstadoCuadreUSD == "SOBRANTE") { <span class="badge bg-warning bg-opacity-10 text-warning px-2 py-1 rounded-pill">SOBRANTE</span> }
                                        else { <span class="badge bg-success bg-opacity-10 text-success px-2 py-1 rounded-pill opacity-75">CUADRADO</span> }
                                    }
                                    else { <span class="badge bg-secondary bg-opacity-10 text-secondary px-2 py-1 rounded-pill">ABIERTO</span> }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (arqueos != null && arqueos.Count > pageSize)
        {
            var totalPages = (int)Math.Ceiling((double)arqueos.Count / pageSize);
            <div class="pagination-container p-3 border-top bg-white d-flex justify-content-center align-items-center position-relative">
                <div class="position-absolute start-0 ps-4 d-none d-lg-block">
                    <span class="small text-muted">Mostrando @(Math.Min(arqueos.Count, (currentPage - 1) * pageSize + 1)) a @(Math.Min(arqueos.Count, currentPage * pageSize)) de @arqueos.Count registros</span>
                </div>
                <div class="pagination-carousel-container">
                    <ul class="pagination pagination-premium mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetPage(currentPage - 1)" title="Anterior">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                        </li>
                        
                        @{
                            int maxVisible = 5;
                            int startPage = Math.Max(1, Math.Min(currentPage - 2, totalPages - maxVisible + 1));
                            int endPage = Math.Min(totalPages, startPage + maxVisible - 1);
                            
                            if (totalPages > maxVisible && endPage == totalPages) startPage = Math.Max(1, totalPages - maxVisible + 1);

                            for (int i = startPage; i <= endPage; i++)
                            {
                                var pageNum = i;
                                <li class="page-item @(currentPage == pageNum ? "active" : "") page-item-animated" @key="pageNum">
                                    <button class="page-link" @onclick="() => SetPage(pageNum)">@pageNum</button>
                                </li>
                            }

                            if (endPage < totalPages)
                            {
                                if (endPage < totalPages - 1)
                                {
                                    <li class="pagination-ellipsis">...</li>
                                }
                                <li class="page-item @(currentPage == totalPages ? "active" : "") page-item-animated">
                                    <button class="page-link" @onclick="() => SetPage(totalPages)">@totalPages</button>
                                </li>
                            }
                        }

                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetPage(currentPage + 1)" title="Siguiente">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        }
    </div>

    <!-- Historial de movimientos por turno -->
    <div class="report-card mb-4 shadow-sm animate__animated animate__fadeInUp" style="border-radius: 16px; border: none; overflow: hidden;">
        <div class="report-card-title px-4 py-3 bg-white d-flex justify-content-between align-items-center" style="border-bottom: 1px solid #f1f3f5;">
            <span class="fw-bold" style="font-size: 1.1rem; color: var(--text-dark);">
                <i class="fas fa-history me-2 text-primary"></i>
                @(selectedTurnoId == null ? "Seleccione un turno para ver historial de movimientos" : $"Historial de movimientos por turno #{selectedTurnoId}")
            </span>
            @if (loadingMovimientos)
            {
                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
            }
        </div>
        
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead style="background: #f8f9fa;">
                    <tr>
                        <th class="ps-4 py-3 text-uppercase small fw-bold text-muted">Tipo</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted">Referencia</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted">Hora</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted">Cliente</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted">Método Pago</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted text-end">Monto</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted text-end" title="Monto con el que paga">Pagado</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted text-end">Vuelto</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted text-end">Reverso</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted text-end">Total</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted pe-4 text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (selectedTurnoId == null)
                    {
                        <tr>
                            <td colspan="11" class="text-center py-5 text-muted">
                                <i class="fas fa-mouse-pointer fa-2x mb-2 opacity-50"></i>
                                <p class="mb-0">Haga clic en un turno de la tabla superior para ver sus detalles</p>
                            </td>
                        </tr>
                    }
                    else if (loadingMovimientos)
                    {
                        @for (int i = 0; i < 3; i++)
                        {
                            <tr>
                                <td colspan="9" class="py-3 ps-4"><div class="skeleton" style="height: 20px;"></div></td>
                            </tr>
                        }
                    }
                    else if (movimientosTurno == null || !movimientosTurno.Any())
                    {
                        <tr>
                            <td colspan="11" class="text-center py-5 text-muted">
                                <i class="fas fa-info-circle fa-2x mb-2 opacity-50"></i>
                                <p class="mb-0">No se encontraron movimientos para este turno</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var v in movimientosTurno.Skip((currentPageMovimientos - 1) * pageSizeMovimientos).Take(pageSizeMovimientos))
                        {
                            <tr>
                                <td class="ps-4 py-3 fw-bold">
                                    @if (v.TipoMovimiento == "Venta")
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary px-2 rounded">VENTA</span>
                                    }
                                    else if (v.TipoMovimiento == "Regalía")
                                    {
                                        <span class="badge bg-info bg-opacity-10 text-info px-2 rounded"><i class="fas fa-gift me-1"></i>REGALÍA</span>
                                    }
                                    else if (v.TipoMovimiento == "Ingreso")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success px-2 rounded">INGRESO</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger px-2 rounded">EGRESO</span>
                                    }
                                </td>
                                <td class="py-3 fw-bold">@v.Referencia</td>
                                <td class="py-3 text-muted">@v.Fecha.ToString("hh:mm tt")</td>
                                <td class="py-3">
                                    @if(v.Cliente == "N/A")
                                    {
                                        <span class="text-muted fst-italic">--</span>
                                    }
                                    else
                                    {
                                        @v.Cliente
                                    }
                                </td>
                                <td class="py-3">
                                    <span class="small fw-semibold">@v.MetodoPago</span>
                                </td>
                                <td class="py-3 text-end fw-bold @(v.TipoMovimiento == "Egreso" ? "text-danger" : v.TipoMovimiento == "Regalía" ? "text-info" : "text-primary")">
                                    @if(v.Monto == 0 && (v.TipoMovimiento == "Ingreso" || v.TipoMovimiento == "Egreso")) {
                                        <span class="text-muted">--</span>
                                    } else {
                                        @(v.TipoMovimiento == "Egreso" ? "-" : "")@v.SimboloMonedaMonto @v.Monto.ToString("N2")
                                    }
                                </td>
                                <td class="py-3 text-end fw-bold text-dark">
                                    @if(v.MontoPagado == 0 && (v.TipoMovimiento == "Ingreso" || v.TipoMovimiento == "Egreso")) {
                                        <span class="text-muted">--</span>
                                    } else {
                                        @v.SimboloMonedaPago @v.MontoPagado.ToString("N2")
                                    }
                                </td>
                                <td class="py-3 text-end fw-semibold text-success">
                                    @(v.Vuelto > 0 ? $"{v.SimboloMonedaVuelto} {v.Vuelto.ToString("N2")}" : "--")
                                </td>
                                <td class="py-3 text-end fw-semibold text-danger">
                                    @if(v.MontoReverso > 0)
                                    {
                                        <span title="@v.MotivoReverso" style="cursor: help; border-bottom: 1px dotted #dc3545;">
                                            @v.SimboloMonedaPago @v.MontoReverso.ToString("N2")
                                        </span>
                                    }
                                    else
                                    {
                                        <text>--</text>
                                    }
                                </td>
                                <td class="py-3 text-end fw-bold @(v.MontoTotal < 0 ? "text-danger" : "text-success")">
                                    @(v.MontoTotal < 0 ? "-" : "")@(v.TipoMovimiento == "Ingreso" ? v.SimboloMonedaMonto : v.SimboloMonedaPago) @Math.Abs(v.MontoTotal).ToString("N2")
                                </td>
                                <td class="py-3 pe-4 text-center">
                                    @if (v.Estado == "ANULADA")
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger px-2 py-1 rounded-pill">ANULADA</span>
                                    }
                                    else if (v.Estado == "EFECTUADA")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success px-2 py-1 rounded-pill">EFECTUADA</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary px-2 py-1 rounded-pill">COMPLETADO</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (movimientosTurno != null && movimientosTurno.Count > pageSizeMovimientos)
        {
            var totalPages = (int)Math.Ceiling((double)movimientosTurno.Count / pageSizeMovimientos);
            <div class="pagination-container p-3 border-top bg-white d-flex justify-content-center align-items-center position-relative">
                <div class="position-absolute start-0 ps-4 d-none d-lg-block">
                    <span class="small text-muted">Mostrando @(Math.Min(movimientosTurno.Count, (currentPageMovimientos - 1) * pageSizeMovimientos + 1)) a @(Math.Min(movimientosTurno.Count, currentPageMovimientos * pageSizeMovimientos)) de @movimientosTurno.Count registros</span>
                </div>
                <div class="pagination-carousel-container">
                    <ul class="pagination pagination-premium mb-0">
                        <li class="page-item @(currentPageMovimientos == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetPageMovimientos(currentPageMovimientos - 1)" title="Anterior">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                        </li>
                        
                        @{
                            int maxVisible = 5;
                            int startPage = Math.Max(1, Math.Min(currentPageMovimientos - 2, totalPages - maxVisible + 1));
                            int endPage = Math.Min(totalPages, startPage + maxVisible - 1);
                            
                            if (totalPages > maxVisible && endPage == totalPages) startPage = Math.Max(1, totalPages - maxVisible + 1);

                            for (int i = startPage; i <= endPage; i++)
                            {
                                var pageNum = i;
                                <li class="page-item @(currentPageMovimientos == pageNum ? "active" : "") page-item-animated" @key="@("m-" + pageNum)">
                                    <button class="page-link" @onclick="() => SetPageMovimientos(pageNum)">@pageNum</button>
                                </li>
                            }

                            if (endPage < totalPages)
                            {
                                if (endPage < totalPages - 1)
                                {
                                    <li class="pagination-ellipsis">...</li>
                                }
                                <li class="page-item @(currentPageMovimientos == totalPages ? "active" : "") page-item-animated">
                                    <button class="page-link" @onclick="() => SetPageMovimientos(totalPages)">@totalPages</button>
                                </li>
                            }
                        }

                        <li class="page-item @(currentPageMovimientos == totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetPageMovimientos(currentPageMovimientos + 1)" title="Siguiente">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public DateTime StartDate { get; set; }
    [Parameter] public DateTime EndDate { get; set; }
    private List<ArqueoInsightDTO>? arqueos;
    private int currentPage = 1;
    private int pageSize = 10;

    private int? selectedTurnoId;
    private List<MovimientoTurnoDTO>? movimientosTurno;
    private bool loadingMovimientos = false;
    private int currentPageMovimientos = 1;
    private int pageSizeMovimientos = 10;

    protected override async Task OnParametersSetAsync() 
    {
        currentPage = 1; // Reset al cambiar fechas
        selectedTurnoId = null;
        movimientosTurno = null;
        await LoadData();
    }

    private async Task LoadData()
    {
        arqueos = null;
        StateHasChanged();
        arqueos = await ReportService.GetArqueoInsightsAsync(StartDate, EndDate);
        StateHasChanged();
    }

    private async Task SelectTurno(int idTurno)
    {
        if (selectedTurnoId == idTurno) return;
        
        selectedTurnoId = idTurno;
        currentPageMovimientos = 1;
        loadingMovimientos = true;
        movimientosTurno = null;
        StateHasChanged();
        
        movimientosTurno = await ReportService.GetMovimientosPorTurnoAsync(idTurno);
        loadingMovimientos = false;
        StateHasChanged();
    }

    private void SetPage(int page)
    {
        currentPage = page;
        StateHasChanged();
    }

    private void SetPageMovimientos(int page)
    {
        currentPageMovimientos = page;
        StateHasChanged();
    }
}


